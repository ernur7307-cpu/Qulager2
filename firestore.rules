rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пікірлер: оқуға — кез келген адам, жазуға — кез келген адам,
    // өшіруге — тек пікірді жазған адам (uid сәйкес келсе). Өзгертуге болмайды.
    match /reviews/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'rating', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 500
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
